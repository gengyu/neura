# Neura local deployment configuration

# Model provider
NEURA_MODEL_PROVIDER=deepseek
NEURA_MODEL=deepseek-chat
NEURA_MODEL_BASE_URL=https://api.deepseek.com
NEURA_MODEL_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
NEURA_MODEL_API_KEY_ENV=DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=replace-with-your-key

# Local data
NEURA_DATABASE_PATH=data/neura.db
NEURA_INBOX_PATH=data/inbox
NEURA_SCREENSHOT_PATH=data/screenshots

# Runtime
NEURA_HEARTBEAT_INTERVAL_MS=5000
NEURA_WEBHOOK_ENABLED=true
NEURA_WEBHOOK_HOST=127.0.0.1
NEURA_WEBHOOK_PORT=8787
NEURA_WEBHOOK_TOKEN=
NEURA_ADMIN_UI_ENABLED=true
NEURA_ADMIN_HOST=127.0.0.1
NEURA_ADMIN_PORT=8790
NEURA_ADMIN_TOKEN=

# Ingest budget. Large inputs are previewed/chunk-indexed instead of being sent
# wholesale to the model.
NEURA_MAX_MODEL_INPUT_CHARS=24000
NEURA_MAX_FILE_READ_BYTES=512000
NEURA_PREVIEW_HEAD_CHARS=14000
NEURA_PREVIEW_TAIL_CHARS=6000
NEURA_INGEST_CHUNK_CHARS=6000
NEURA_INGEST_MAX_CHUNKS=12

# Local safety policy
NEURA_ALLOW_OUTPUT=true
NEURA_ALLOW_FILE_READ=true
NEURA_ALLOW_FILE_WRITE=true
NEURA_ALLOW_NETWORK=true
NEURA_ALLOW_COMMAND_EXECUTION=false
NEURA_REQUIRE_CONFIRMATION=true
