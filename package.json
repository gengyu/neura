{
  "name": "neura",
  "version": "0.1.0",
  "description": "A UI-less personal agent runtime.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.29.2",
  "keywords": [
    "agent",
    "memory",
    "personal-ai",
    "runtime",
    "cli",
    "bun"
  ],
  "bin": {
    "neura": "./bin/neura.ts"
  },
  "files": [
    "apps",
    "bin",
    "docs",
    "packages",
    "plugins",
    "scripts",
    ".env.example",
    "neura.config.ts",
    "README.md",
    "tsconfig.json"
  ],
  "scripts": {
    "neura": "bun ./bin/neura.ts",
    "start": "bun ./bin/neura.ts start",
    "stop": "bun ./bin/neura.ts stop",
    "restart": "npm run stop && npm run start",
    "status": "bun ./bin/neura.ts status",
    "doctor": "bun ./bin/neura.ts doctor",
    "model:doctor": "bun ./bin/neura.ts model doctor",
    "model:test": "bun ./bin/neura.ts model test",
    "install:local": "bash ./scripts/install-local.sh",
    "uninstall:local": "bash ./scripts/uninstall-local.sh",
    "check": "bunx tsc --noEmit",
    "smoke": "NEURA_MODEL_PROVIDER=mock bun ./scripts/smoke-test.ts",
    "test": "pnpm run smoke",
    "release:check": "pnpm run check && pnpm test",
    "pack:npm": "pnpm run release:check && npm pack --dry-run",
    "publish:npm": "npm publish",
    "publish:npm:public": "npm publish --access public",
    "prepublishOnly": "pnpm run release:check"
  },
  "engines": {
    "bun": ">=1.3.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@langchain/classic": "^1.0.32",
    "@langchain/core": "^1.1.45",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/openai": "^1.4.5",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "cosine-similarity": "^1.0.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "natural": "^8.1.1",
    "openai": "^6.35.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^24.9.2",
    "typescript": "^5.9.3"
  }
}
